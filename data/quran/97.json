{"n":97,"type":"meccan","count":5,"wbw":true,"verses":[{"a":"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ","t":"ইন্না- আনযালনা-হু ফী লাইলাতিল কাদর","b":"আমি একে নাযিল করেছি শবে-কদরে।","w":[["إِنَّآ","নিশ্চয়ই","ইন্না-"],["أَنزَلۡنَٰهُ","তা আমরা অবতীর্ণ করেছি","আনযালনা-হু"],["فِي","মধ্যে","ফী"],["لَيۡلَةِ","রাতের","লাইলাতি"],["ٱلۡقَدۡرِ","কদরের/ মহিমার","আলকাদরি"]]},{"a":"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ","t":"ওয়ামা- আদরা-কা মা- লাইলাতুল কাদর","b":"শবে-কদর সমন্ধে আপনি কি জানেন","w":[["وَمَآ","এবং কিসে","ওয়ামা-"],["أَدۡرَىٰكَ","তোমাকে জানাবে","আদরা-কা"],["مَا","কি সেই","মা-"],["لَيۡلَةُ","রাত","লাইলাতু"],["ٱلۡقَدۡرِ","কদরের","আলকাদরি"]]},{"a":"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ","t":"লাইলাতুল কাদরি খাইরুম মিন আলফি শাহর","b":"শবে-কদর হল এক হাজার মাস অপেক্ষা শ্রেষ্ঠ।","w":[["لَيۡلَةُ","রাত","লাইলাতু"],["ٱلۡقَدۡرِ","কদরের","আলকাদরি"],["خَيۡرٞ","শ্রেষ্ঠ","খাইরুন"],["مِّنۡ","হতেও","ম্মিন"],["أَلۡفِ","হাজার","আলফি"],["شَهۡرٖ","মাস","শাহরিন"]]},{"a":"تَنَزَّلُ ٱلۡمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ","t":"তানায্যালুল মালা-ইকাতু ওয়ার্রূহু ফীহা- বিইযনি রাব্বিহিম মিন কুল্লি আমর","b":"এতে প্রত্যেক কাজের জন্যে ফেরেশতাগণ ও রূহ অবতীর্ণ হয় তাদের পালনকর্তার নির্দেশক্রমে।","w":[["تَنَزَّلُ","অবতীর্ণ হয়","তানায্যালু"],["ٱلۡمَلَـٰٓئِكَةُ","ফেরেশতারা","আলমালা-ইকাতু"],["وَٱلرُّوحُ","এবং রূহ (জিব্রাঈল)","ওয়ার্রূহু"],["فِيهَا","তার মধ্যে","ফীহা-"],["بِإِذۡنِ","অনুমতিক্রমে","বিইযনি"],["رَبِّهِم","তাদের রবের","রাব্বিহিম"],["مِّن","প্রত্যেক","ম্মিন"],["كُلِّ","সব","কুল্লি"],["أَمۡرٖ","কাজে","আমরিন"]]},{"a":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ","t":"সালা-মুন হিয়া হাত্তা- মাতলা‘ইল ফাজর","b":"এটা নিরাপত্তা, যা ফজরের উদয় পর্যন্ত অব্যাহত থাকে।","w":[["سَلَٰمٌ","শান্তির","সালা-মুন"],["هِيَ","সেই (রাত)","হিয়া"],["حَتَّىٰ","পর্যন্ত","হাত্তা-"],["مَطۡلَعِ","উদয়","মাতলা‘ই"],["ٱلۡفَجۡرِ","ঊষার","আলফাজরি"]]}]}
{"n":107,"type":"meccan","count":7,"wbw":true,"verses":[{"a":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","t":"আরাআইতাল লাযী ইউকায্যিবু বিদ্দীন","b":"আপনি কি দেখেছেন তাকে, যে বিচারদিবসকে মিথ্যা বলে","w":[["أَرَءَيۡتَ","তুমি কি দেখেছ","আরাআইতা"],["ٱلَّذِي","(তাকে) যে","আল্লাযী"],["يُكَذِّبُ","মিথ্যা অভিহিত করে","ইউকায্যিবু"],["بِٱلدِّينِ","বিচার দিনকে","বিদ্দীনি"]]},{"a":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","t":"ফাযা-লিকাল লাযী ইয়াদু‘উল ইয়াতীম","b":"সে সেই ব্যক্তি, যে এতীমকে গলা ধাক্কা দেয়","w":[["فَذَٰلِكَ","সে তো সে-ই","ফাযা-লিকা"],["ٱلَّذِي","যে","আল্লাযী"],["يَدُعُّ","ধাক্কা দেয়","ইয়াদু‘উ"],["ٱلۡيَتِيمَ","ইয়াতিমকে","আলইয়াতীমা"]]},{"a":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","t":"ওয়ালা- ইয়াহুদ্দু ‘আলা- তা‘আ-মিল মিসকীন","b":"এবং মিসকীনকে অন্ন দিতে উৎসাহিত করে না।","w":[["وَلَا","এবং না","ওয়ালা-"],["يَحُضُّ","উৎসাহিত করে","ইয়াহুদ্দু"],["عَلَىٰ","ব্যাপারে","‘আলা-"],["طَعَامِ","খাদ্যদানের","তা‘আ-মি"],["ٱلۡمِسۡكِينِ","অভাবগ্রস্তকে","আলমিসকীনি"]]},{"a":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","t":"ফাওয়াইলুল লিলমুসাল্লীন","b":"অতএব দুর্ভোগ সেসব নামাযীর","w":[["فَوَيۡلٞ","অতএব দুর্ভোগ","ফাওয়াইলুন"],["لِّلۡمُصَلِّينَ","(ঐসব) সালাত আদায়কারীদের জন্য","ল্লিলমুসাল্লীনা"]]},{"a":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","t":"আল্লাযীনা হুম ‘আন সালা-তিহিম সা-হূন","b":"যারা তাদের নামায সম্বন্ধে বে-খবর","w":[["ٱلَّذِينَ","যাদের (বৈশিষ্ট্য হলো)","আল্লাযীনা"],["هُمۡ","তারা","হুম"],["عَن","সম্বন্ধে","‘আন"],["صَلَاتِهِمۡ","তাদের সালাত","সালা-তিহিম"],["سَاهُونَ","উদাসীন","সা-হূনা"]]},{"a":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","t":"আল্লাযীনা হুম ইউরা-ঊন","b":"যারা তা লোক-দেখানোর জন্য করে","w":[["ٱلَّذِينَ","যাদের (বৈশিষ্ট্য হলো)","আল্লাযীনা"],["هُمۡ","তারা","হুম"],["يُرَآءُونَ","লোকদেখানোর (কাজ করে)","ইউরা-ঊনা"]]},{"a":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","t":"ওয়ায়ামনা‘ঊনাল মা-‘ঊন","b":"এবং নিত্য ব্যবহার্য্য বস্তু অন্যকে দেয় না।","w":[["وَيَمۡنَعُونَ","এবং দেওয়া হতে বিরত থাকে","ওয়ায়ামনা‘ঊনা"],["ٱلۡمَاعُونَ","সংসারের প্রয়োজনীয় ছোটখাটো জিনিসের","আলমা-‘ঊনা"]]}]}
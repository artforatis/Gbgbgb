{"n":94,"type":"meccan","count":8,"wbw":true,"verses":[{"a":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","t":"আলাম নাশরাহ লাকা সাদরাক","b":"আমি কি আপনার বক্ষ উম্মুক্ত করে দেইনি","w":[["أَلَمۡ","করি দিই নি?","আলাম"],["نَشۡرَحۡ","আমরা উন্মুক্ত","নাশরাহ"],["لَكَ","তোমার জন্যে","লাকা"],["صَدۡرَكَ","তোমার বক্ষকে","সাদরাকা"]]},{"a":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","t":"ওয়াওয়াদা‘না- ‘আনকা ওয়িযরাক","b":"আমি লাঘব করেছি আপনার বোঝা","w":[["وَوَضَعۡنَا","এবং আমরা নামিয়েছি","ওয়াওয়াদা‘না-"],["عَنكَ","তোমার থেকে","‘আনকা"],["وِزۡرَكَ","তোমার ভার","ওয়িযরাকা"]]},{"a":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","t":"আল্লাযী আনকাদা যাহরাক","b":"যা ছিল আপনার জন্যে অতিশয় দুঃসহ।","w":[["ٱلَّذِيٓ","যা","আল্লাযী"],["أَنقَضَ","ভেঙ্গে দিচ্ছিলো","আনকাদা"],["ظَهۡرَكَ","তোমার পিঠ","যাহরাকা"]]},{"a":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","t":"ওয়ারাফা‘না- লাকা যিকরাক","b":"আমি আপনার আলোচনাকে সমুচ্চ করেছি।","w":[["وَرَفَعۡنَا","ও আমরা সুউচ্চ করেছি","ওয়ারাফা‘না-"],["لَكَ","তোমার জন্যে","লাকা"],["ذِكۡرَكَ","তোমার খ্যাতি/ স্মরণকে","যিকরাকা"]]},{"a":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","t":"ফাইন্না মা‘আল ‘উসরি ইউসরা-","b":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","w":[["فَإِنَّ","অতএব নিশ্চয়ই","ফাইন্না"],["مَعَ","সাথে","মা‘আ"],["ٱلۡعُسۡرِ","কষ্টের","আল‘উসরি"],["يُسۡرًا","স্বস্তি (আছে)","ইউসরান"]]},{"a":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","t":"ইন্না মা‘আল ‘উসরি ইউসরা-","b":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","w":[["إِنَّ","নিশ্চয়ই","ইন্না"],["مَعَ","সাথে","মা‘আ"],["ٱلۡعُسۡرِ","কষ্টের","আল‘উসরি"],["يُسۡرٗا","স্বস্তি (আছে)","ইউসরান"]]},{"a":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","t":"ফাইযা- ফারাগতা ফানসাব","b":"অতএব, যখন অবসর পান পরিশ্রম করুন।","w":[["فَإِذَا","অতএব যখনই","ফাইযা-"],["فَرَغۡتَ","তুমি অবসর হও","ফারাগতা"],["فَٱنصَبۡ","তুমি তখন ইবাদাত করো","ফানসাব"]]},{"a":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","t":"ওয়াইলা- রাব্বিকা ফারগাব","b":"এবং আপনার পালনকর্তার প্রতি মনোনিবেশ করুন।","w":[["وَإِلَىٰ","এবং প্রতি","ওয়াইলা-"],["رَبِّكَ","তোমার রবের","রাব্বিকা"],["فَٱرۡغَب","তখন মনোনিবেশ করো","ফারগাব"]]}]}